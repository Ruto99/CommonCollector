<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LabelCollector</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.1" />
    <!-- エクセル（.xlsx / .xlsm / .xls）読み込み用 -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
  </ItemGroup>

</Project>
