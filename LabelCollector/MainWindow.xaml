<Window x:Class="LabelCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:adt="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:vm="clr-namespace:LabelCollector.ViewModels"
        xmlns:local="clr-namespace:LabelCollector"
        Title="{Binding WindowTitle}" Height="700" Width="1150"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="MinWidth" Value="56"/>
        </Style>

        <!-- AvalonDock のタブ（シート）にだけ当てるスタイル -->
        <Style x:Key="SheetTabStyle" TargetType="{x:Type ad:LayoutItem}">
            <Setter Property="Title" Value="{Binding Model.Name}"/>
            <Setter Property="ToolTip" Value="{Binding Model.Name}"/>
        </Style>
        <local:SheetItemStyleSelector x:Key="SheetItemStyleSelector"
                                      DocumentStyle="{StaticResource SheetTabStyle}"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Gesture="F5" Command="{Binding RefreshAllCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- メインメニュー -->
        <Menu DockPanel.Dock="Top" x:Name="MainMenu">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="中間データを開く(_O)..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="作業フォルダを変更(_W)..." Command="{Binding ChangeWorkDirectoryCommand}"/>
                <Separator/>
                <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="名前を付けて保存(_A)..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="選択シートを中間データに書き出し(_E)..." Command="{Binding ExportSheetCommand}"/>
                <MenuItem Header="中間データからシートを追加(_I)..." Command="{Binding ImportSheetsCommand}"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="編集(_E)">
                <MenuItem Header="切り取り(_T)" Command="ApplicationCommands.Cut"/>
                <MenuItem Header="コピー(_C)" Command="ApplicationCommands.Copy"/>
                <MenuItem Header="貼り付け(_P)" Command="ApplicationCommands.Paste"/>
                <Separator/>
                <MenuItem Header="すべて選択(_A)" Command="ApplicationCommands.SelectAll"/>
            </MenuItem>

            <MenuItem Header="シート(_S)">
                <!-- 登録されているデータ元の種類が並ぶ（MainWindow.xaml.cs で作る） -->
                <MenuItem x:Name="MenuAddSheet" Header="シートを追加(_A)"/>
                <Separator/>
                <MenuItem Header="シートを開く(_O)" Command="{Binding OpenCommand}"/>
                <MenuItem Header="シートを削除(_R)" Command="{Binding RemoveSheetCommand}"/>
                <Separator/>
                <MenuItem Header="全て更新(_U)" Command="{Binding RefreshAllCommand}" InputGestureText="F5"/>
            </MenuItem>

            <MenuItem Header="表示(_V)" SubmenuOpened="ViewMenu_SubmenuOpened">
                <MenuItem x:Name="MenuShowSheets" Header="エクスプローラー(_F)" Click="MenuShowSheets_Click"/>
                <MenuItem x:Name="MenuShowProperties" Header="プロパティ(_P)" Click="MenuShowProperties_Click"/>
                <MenuItem x:Name="MenuShowLog" Header="ログ(_L)" Click="MenuShowLog_Click"/>
                <MenuItem x:Name="MenuShowToolbar" Header="ツールバー(_T)" Click="MenuShowToolbar_Click"/>
                <Separator/>
                <MenuItem Header="ログをクリア(_C)" Click="ClearLog_Click"/>
                <MenuItem Header="ログフォルダを開く(_O)" Click="OpenLogFolder_Click"/>
            </MenuItem>

            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="LabelCollector のバージョン情報(_A)" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- メインツールバー -->
        <ToolBarTray x:Name="MainToolBarTray" DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0" Header="中間データ(.lc)">
                <Button Style="{StaticResource ToolButton}" Content="📂 開く" Command="{Binding OpenFileCommand}"
                        ToolTip="中間データ(.lc)を開いて、現在の内容と入れ替えます"/>
                <Button Style="{StaticResource ToolButton}" Content="💾 保存" Command="{Binding SaveCommand}"
                        ToolTip="現在の中間データ(.lc)に保存します（編集内容は自動でも保存されます）"/>
                <Button Style="{StaticResource ToolButton}" Content="名前を付けて保存" Command="{Binding SaveAsCommand}"
                        ToolTip="保存先の中間データ(.lc)を選んで、全シートを保存します"/>
                <Separator/>
                <Button Style="{StaticResource ToolButton}" Content="選択シートを書き出し" Command="{Binding ExportSheetCommand}"
                        ToolTip="左のエクスプローラーで選んだシートの表を、単独の中間データ(.lc)に書き出します"/>
                <Button Style="{StaticResource ToolButton}" Content="中間データから追加" Command="{Binding ImportSheetsCommand}"
                        ToolTip="別の中間データ(.lc)のシートを、現在の内容に追加します"/>
            </ToolBar>
            <ToolBar Band="1" BandIndex="0" Header="シート">
                <Button x:Name="AddSheetButton" Style="{StaticResource ToolButton}" Content="＋ シート追加 ▾" Click="AddSheetButton_Click"
                        ToolTip="データ元（エクセルファイル・エクセルフォルダなど）を選んで、シートを追加します"/>
                <Button Style="{StaticResource ToolButton}" Content="シートを開く" Command="{Binding OpenCommand}"
                        ToolTip="選択中のシートをタブで開きます"/>
                <Button Style="{StaticResource ToolButton}" Content="削除" Command="{Binding RemoveSheetCommand}"
                        ToolTip="選択中のシートを一覧から削除します"/>
                <Separator/>
                <Button Style="{StaticResource ToolButton}" Content="🔄 全て更新" Command="{Binding RefreshAllCommand}"
                        ToolTip="登録済みの全シートをデータ元から読み直します"/>
            </ToolBar>
            <ToolBar Band="1" BandIndex="1" Header="ログ">
                <ToggleButton x:Name="LogToggle" Style="{StaticResource {x:Type ToggleButton}}"
                              Content="📋 ログ表示" Padding="10,4" Margin="1,0" MinWidth="72"
                              IsChecked="True" Click="LogToggle_Click"
                              ToolTip="ログ欄の表示／非表示を切り替えます"/>
                <Button Style="{StaticResource ToolButton}" Content="クリア" Click="ClearLog_Click"
                        ToolTip="ログ欄の表示を消します（ファイルのログは残ります）"/>
                <Button Style="{StaticResource ToolButton}" Content="ログフォルダ" Click="OpenLogFolder_Click"
                        ToolTip="ログファイルの保存先を開きます"/>
            </ToolBar>
        </ToolBarTray>

        <!-- ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"/>
            </StatusBarItem>
        </StatusBar>

        <ad:DockingManager x:Name="Dock" DocumentsSource="{Binding OpenSheets}"
                           LayoutItemContainerStyleSelector="{StaticResource SheetItemStyleSelector}">
            <ad:DockingManager.Theme>
                <adt:Vs2013LightTheme/>
            </ad:DockingManager.Theme>

            <!-- シート（SheetViewModel）はタブとして SheetView で表示する。
                 LayoutItemTemplate だと左ペインやログ欄にも適用されてしまうため、型指定にしている -->
            <ad:DockingManager.Resources>
                <DataTemplate DataType="{x:Type vm:SheetViewModel}">
                    <local:SheetView/>
                </DataTemplate>
            </ad:DockingManager.Resources>

            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">

                    <!-- 左：作業フォルダのエクスプローラー（フォルダ・中間データ(.lc)・シート） -->
                    <ad:LayoutAnchorablePane DockWidth="260">
                        <ad:LayoutAnchorable x:Name="SheetsAnchorable" Title="エクスプローラー" ContentId="sheets" CanClose="False">
                            <TreeView x:Name="ExplorerTree" ItemsSource="{Binding Explorer.Roots}" BorderThickness="0"
                                      SelectedItemChanged="ExplorerTree_SelectedItemChanged"
                                      MouseDoubleClick="ExplorerTree_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="ExplorerTree_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="ExplorerTree_ContextMenuOpening">
                                <TreeView.Resources>
                                    <!-- フォルダ・中間データ -->
                                    <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="1" ToolTip="{Binding FullPath}">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBold}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                    <!-- 開いている中間データの中のシート -->
                                    <DataTemplate DataType="{x:Type vm:SheetViewModel}">
                                        <StackPanel Orientation="Horizontal" Margin="1">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:LoadingNode}">
                                        <TextBlock Text="{Binding Name}" Foreground="Gray"/>
                                    </DataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, FallbackValue=False}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="CtxOpenFile" Header="開く(_O)" Click="CtxOpenFile_Click"/>
                                        <MenuItem x:Name="CtxCreateFile" Header="新しい中間データ(.lc)を作成(_N)..." Click="CtxCreateFile_Click"/>
                                        <MenuItem x:Name="CtxDeleteFile" Header="中間データを削除(_D)" Click="CtxDeleteFile_Click"/>
                                        <MenuItem x:Name="CtxAddSheet" Header="シートを追加(_A)"/>
                                        <MenuItem x:Name="CtxOpenSheet" Header="シートを開く(_O)" Command="{Binding OpenCommand}"/>
                                        <MenuItem x:Name="CtxRemoveSheet" Header="シートを削除(_R)" Command="{Binding RemoveSheetCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="エクスプローラーで開く(_X)" Click="CtxShowInExplorer_Click"/>
                                        <MenuItem Header="最新の情報に更新(_U)" Click="CtxReload_Click"/>
                                        <MenuItem Header="作業フォルダを変更(_W)..." Command="{Binding ChangeWorkDirectoryCommand}"/>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>

                    <ad:LayoutPanel Orientation="Vertical">
                        <!-- 右上：開いたシートがタブとして並ぶ -->
                        <ad:LayoutDocumentPane/>

                        <!-- 右下：ログ -->
                        <ad:LayoutAnchorablePane DockHeight="190">
                            <ad:LayoutAnchorable x:Name="LogAnchorable" Title="ログ" ContentId="log" CanClose="True">
                                <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="None"
                                          SelectionUnit="FullRow" BorderThickness="0"
                                          RowHeaderWidth="0" CanUserAddRows="False">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                    <Setter Property="Foreground" Value="#B45F06"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="#C00000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="時刻" Binding="{Binding TimeText}" MinWidth="95" Width="95"/>
                                        <DataGridTextColumn Header="レベル" Binding="{Binding LevelText}" MinWidth="60" Width="60"/>
                                        <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>

                    <!-- 右：プロパティ（選んだ中間データの中身、またはシートの設定を編集する） -->
                    <ad:LayoutAnchorablePane DockWidth="300">
                        <ad:LayoutAnchorable x:Name="PropertiesAnchorable" Title="プロパティ" ContentId="properties" CanClose="True">
                            <local:PropertyPanel x:Name="PropertyView"/>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
