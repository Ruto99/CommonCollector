<UserControl x:Class="LabelCollector.SheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520">
    <UserControl.Resources>
        <!-- 行の色：新しく追加された行は緑、データ元から消えた行は灰色 -->
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="New">
                    <Setter Property="Background" Value="#E6F4EA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Missing">
                    <Setter Property="Background" Value="#EEEEEE"/>
                    <Setter Property="Foreground" Value="Gray"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 手入力の列で、まだ何も入力されていないセルの枠の色（SheetView.xaml.cs の ManualCellStyle で使う） -->
        <SolidColorBrush x:Key="EmptyManualCellBrush" Color="#E53935"/>

        <!-- 「複数の値」の列のセル：右端の ▾ で、値の一覧をセルの下に開く（SheetView.xaml.cs の CreateGrid で使う） -->
        <ControlTemplate x:Key="MultiValueCellTemplate" TargetType="DataGridCell">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="▾" Click="MultiValueButton_Click" Focusable="False"
                            Padding="4,0" BorderThickness="0" Background="Transparent" Foreground="Gray" Cursor="Hand"
                            ToolTip="値を複数入力する一覧を開きます（Alt+↓）"/>
                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>
    <DockPanel Margin="6">

        <!-- 下部：状態表示 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="消えた行を削除" Command="{Binding RemoveMissingCommand}"
                    Padding="12,3" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="更新" Command="{Binding RefreshCommand}"
                    Padding="18,3" Margin="8,0,0,0" MinWidth="72"
                    ToolTip="全データ元を読み直します（設定は右のプロパティウィンドウ）"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- 表：データ元ごとのタブ（親）と、エクセルフォルダならフォルダごとのタブ（子）。SheetView.xaml.cs で作る -->
        <ContentControl x:Name="TabsHost" Focusable="False"/>
    </DockPanel>
</UserControl>
