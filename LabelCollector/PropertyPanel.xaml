<UserControl x:Class="LabelCollector.PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext は MainViewModel。選択中のシート（SelectedSheet）の設定を表示・編集する -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- シート未選択のとき -->
        <TextBlock Text="左の一覧でシートを選択すると、ここに設定が表示されます"
                   TextWrapping="Wrap" Margin="10" Foreground="Gray">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedSheet}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel DataContext="{Binding SelectedSheet}">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- 一番下：プロパティ（エクセルのフォルダ＋キー列名）を追加するボタン -->
            <Border DockPanel.Dock="Bottom" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="6">
                <StackPanel>
                    <Button Content="＋ エクセルの指定を追加" Command="{Binding AddExcelSourceCommand}"
                            Padding="10,5" HorizontalAlignment="Stretch"
                            Visibility="{Binding IsExcel, Converter={StaticResource BoolToVis}}"
                            ToolTip="読み込むエクセルのフォルダと、キーにする列名の指定を追加します"/>
                    <TextBlock Text="フォルダのシートには追加できません" Foreground="Gray" HorizontalAlignment="Center"
                               Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,4,8,8">

                    <!-- シート共通 -->
                    <TextBlock Text="シート" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="名前" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="Setting_LostFocus"/>
                        <TextBlock Grid.Row="1" Text="種類" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TypeName}" Margin="4,4"/>
                    </Grid>

                    <!-- フォルダ（ファイル一覧）のシート -->
                    <StackPanel Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="フォルダ" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="フォルダ" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding FolderPath}" LostFocus="Setting_LostFocus"
                                     ToolTip="{Binding FolderPath}"/>
                            <TextBlock Grid.Row="1" Text="パターン" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FilePattern}" LostFocus="Setting_LostFocus"/>
                        </Grid>
                    </StackPanel>

                    <!-- エクセルのシート：フォルダ＋キー列名の指定が並ぶ -->
                    <StackPanel Visibility="{Binding IsExcel, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="エクセルの指定" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="まだ指定がありません。下の「＋ エクセルの指定を追加」で追加してください"
                                   TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExcelSources.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding ExcelSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2"
                                            Padding="6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="フォルダ" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Grid.Column="1" Text="{Binding FolderPath}" LostFocus="Setting_LostFocus"
                                                     ToolTip="{Binding FolderPath}"/>
                                            <Button Grid.Column="2" Content="…" Command="{Binding BrowseCommand}"
                                                    Margin="4,2,0,2" Padding="6,0" ToolTip="フォルダを選択"/>
                                            <TextBlock Grid.Row="1" Text="キー列名" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Text="{Binding KeyColumn}" LostFocus="Setting_LostFocus"
                                                     ToolTip="キーにする列の見出し（例：ID）。各シートの上から20行以内で探します"/>
                                            <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="削除"
                                                    Command="{Binding RemoveCommand}" HorizontalAlignment="Right"
                                                    Margin="0,4,0,0" Padding="10,1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Content="🔄 このシートを更新" Command="{Binding RefreshCommand}"
                            Margin="0,10,0,0" Padding="10,4" HorizontalAlignment="Left"
                            ToolTip="設定にしたがってデータ元を読み直します"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
