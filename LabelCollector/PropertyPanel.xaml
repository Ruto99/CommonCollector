<UserControl x:Class="LabelCollector.PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LabelCollector"
             xmlns:vm="clr-namespace:LabelCollector.ViewModels"
             xmlns:ms="clr-namespace:LabelCollector.Models.Sources">
    <!--
        DataContext は MainViewModel。PropertyTarget に入っているものを表示・編集する。
          ・中間データ（DataFileViewModel）… ファイルの中身（シートと、その設定）
          ・シート（SheetViewModel）        … そのシートの設定だけ
        データ元の設定は、種類（設定クラス）ごとの DataTemplate で表示する。
        新しい種類のデータ元を追加したら、「データ元ごとの編集欄」に DataTemplate を1つ足す。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:SourceKindNameConverter x:Key="SourceKindName"/>
        <local:ZeroToVisibleConverter x:Key="ZeroToVisible"/>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="0,2,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Content" Value="×"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="4,2,0,2"/>
        </Style>
        <Style x:Key="BottomBar" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ================= データ元の共通部品 ================= -->

        <!-- フォルダの指定（IFolderLocation） -->
        <DataTemplate x:Key="FolderLocationEditor">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="フォルダ" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding FolderPath}" ToolTip="{Binding FolderPath}"
                         LostFocus="Setting_LostFocus"/>
                <Button Grid.Column="2" Content="…" Padding="6,0" Margin="4,2,0,2"
                        Click="BrowseLocation_Click" ToolTip="フォルダを選択"/>
            </Grid>
        </DataTemplate>

        <!-- シート名とキー列名（TableSourceSettings） -->
        <DataTemplate x:Key="TableKeyEditor">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="シート名" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding SheetName}" LostFocus="Setting_LostFocus"
                             ToolTip="読むシートの名前。空なら全シート（キー列が見つかるシートだけ読む）"/>
                </Grid>

                <TextBlock Text="キー列名（上から順に探す）" Style="{StaticResource SubHeader}"/>
                <ItemsControl ItemsSource="{Binding KeyColumns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource RemoveButton}"
                                        Click="RemoveListItem_Click" ToolTip="このキー列名を削除"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" LostFocus="Setting_LostFocus"
                                         ToolTip="キーにする列の見出し（例：ID）。各シートの上から20行以内で探します"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="＋ キー列名を追加" Style="{StaticResource SmallButton}" Click="AddKeyColumn_Click"
                        ToolTip="ファイルによって列名が違うときに、別の列名を追加します。各シートでは上の候補から順に探し、最初に見つかった列をキーにします"/>
            </StackPanel>
        </DataTemplate>

        <!-- 取り込む列（SourceSettings.Columns）：元の列名 → 表の列名 -->
        <DataTemplate x:Key="ColumnsEditor">
            <StackPanel>
                <TextBlock Text="取り込む列（元の列名 → 表の列名）" Style="{StaticResource SubHeader}"/>
                <TextBlock Text="まだありません。キーと取得元だけが表に出ます" Style="{StaticResource EmptyHint}"
                           Visibility="{Binding Columns.Count, Converter={StaticResource ZeroToVisible}}"/>
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SourceColumn, UpdateSourceTrigger=PropertyChanged}" LostFocus="Setting_LostFocus"
                                         ToolTip="データ元での列名（エクセルなら見出しの文字）"/>
                                <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBox Grid.Column="2" Text="{Binding ColumnName, UpdateSourceTrigger=PropertyChanged}" LostFocus="Setting_LostFocus"
                                         ToolTip="表での列名。空なら元の列名と同じ。別のデータ元と同じ名前にすると、同じ列にまとまります"/>
                                <Button Grid.Column="3" Style="{StaticResource RemoveButton}"
                                        Click="RemoveListItem_Click" ToolTip="この列を取り込まない"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                    <Button Content="＋ 列を追加" Style="{StaticResource SmallButton}" Click="AddColumn_Click"/>
                    <Button Content="列の候補を読み込む" Style="{StaticResource SmallButton}" Click="LoadColumns_Click"
                            ToolTip="データ元の見出しなどから、取り込める列をまとめて追加します（不要な列は × で消してください）"/>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ================= データ元ごとの編集欄（種類を増やしたらここに足す） ================= -->

        <!-- エクセルファイル -->
        <DataTemplate DataType="{x:Type ms:ExcelFileSourceSettings}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ファイル" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding FilePath}" ToolTip="{Binding FilePath}"
                             LostFocus="Setting_LostFocus"/>
                    <Button Grid.Column="2" Content="…" Padding="6,0" Margin="4,2,0,2"
                            Click="BrowseLocation_Click" ToolTip="ファイルを選択"/>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TableKeyEditor}" Focusable="False"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColumnsEditor}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>

        <!-- エクセルフォルダ -->
        <DataTemplate DataType="{x:Type ms:ExcelFolderSourceSettings}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FolderLocationEditor}" Focusable="False"/>
                <CheckBox Content="サブフォルダのファイルも読む" IsChecked="{Binding IncludeSubfolders}"
                          Click="Setting_Changed" Margin="70,2,0,2"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TableKeyEditor}" Focusable="False"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColumnsEditor}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>

        <!-- フォルダのファイル一覧 -->
        <DataTemplate DataType="{x:Type ms:FileListSourceSettings}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FolderLocationEditor}" Focusable="False"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="パターン" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding FilePattern}" LostFocus="Setting_LostFocus"
                             ToolTip="対象にするファイル（例：*.pdf）"/>
                </Grid>
                <CheckBox Content="サブフォルダのファイルも読む" IsChecked="{Binding IncludeSubfolders}"
                          Click="Setting_Changed" Margin="70,2,0,2"/>
                <TextBlock Text="キー：フォルダからの相対パス" Style="{StaticResource EmptyHint}" Margin="0,4,0,0"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColumnsEditor}" Focusable="False"/>
                <TextBlock Text="取り込める列：ファイル名・拡張子・フォルダ・更新日時・サイズ" Style="{StaticResource EmptyHint}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ================= シート ================= -->

        <!-- シートの設定（名前・手入力の列・データ元の一覧）。シート単体でも、中間データの中でも使う -->
        <DataTemplate x:Key="SheetBody">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="名前" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="Setting_LostFocus"/>
                </Grid>

                <!-- 手入力の列 -->
                <TextBlock Text="手入力の列" Style="{StaticResource SubHeader}"/>
                <ItemsControl ItemsSource="{Binding ManualColumns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource RemoveButton}"
                                        Click="RemoveListItem_Click" ToolTip="この列を表から外す（入力済みの値はファイルに残ります）"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" LostFocus="Setting_LostFocus"
                                         ToolTip="手入力する列の名前。名前を変えると、前の名前で入力した値は表に出なくなります"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="＋ 手入力の列を追加" Style="{StaticResource SmallButton}" Click="AddManualColumn_Click"/>

                <!-- データ元の一覧（種類ごとの編集欄が並ぶ） -->
                <TextBlock Style="{StaticResource SectionHeader}">
                    <Run Text="データ元（"/><Run Text="{Binding Sources.Count, Mode=OneWay}"/><Run Text="）"/>
                </TextBlock>
                <TextBlock Text="まだありません。「＋ データ元を追加」で追加してください" Style="{StaticResource EmptyHint}"
                           Visibility="{Binding Sources.Count, Converter={StaticResource ZeroToVisible}}"/>
                <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2" Padding="6" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="削除" Padding="8,0"
                                                Click="RemoveSource_Click" ToolTip="このデータ元を削除"/>
                                        <TextBlock Text="{Binding Converter={StaticResource SourceKindName}}"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <!-- 設定クラスの型に合う DataTemplate（上の「データ元ごとの編集欄」）が使われる -->
                                    <ContentControl Content="{Binding}" Focusable="False"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- シート単体：一番下のボタンでデータ元を追加 -->
        <DataTemplate DataType="{x:Type vm:SheetViewModel}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource BottomBar}">
                    <Button Content="＋ データ元を追加" Click="AddSource_Click" Padding="10,5"
                            ToolTip="エクセルファイル・エクセルフォルダなどのデータ元を追加します"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,4,8,8">
                        <TextBlock Text="シート" Style="{StaticResource SectionHeader}"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SheetBody}" Focusable="False"/>
                        <Button Content="🔄 このシートを更新" Command="{Binding RefreshCommand}"
                                Margin="0,10,0,0" Padding="10,4" HorizontalAlignment="Left"
                                ToolTip="全データ元を読み直します"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource EmptyHint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- ================= 中間データ（.lc）：ファイルの中身 ================= -->
        <DataTemplate DataType="{x:Type vm:DataFileViewModel}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource BottomBar}">
                    <Button Content="＋ シートを追加" Command="{Binding AddSheetCommand}"
                            Padding="10,5" IsEnabled="{Binding CanEdit}"
                            ToolTip="この中間データにシートを追加します（データ元は追加後に指定）"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,4,8,8">

                        <!-- ファイルの情報 -->
                        <TextBlock Text="中間データ" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="ファイル" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="Bold" Margin="4,3"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                            <TextBlock Grid.Row="1" Text="場所" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FolderPath}" Margin="4,3"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}"/>
                            <TextBlock Grid.Row="2" Text="更新日時" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdatedText}" Margin="4,3"/>
                            <TextBlock Grid.Row="3" Text="状態" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StateText}" Margin="4,3" TextWrapping="Wrap"/>
                            <Button Grid.Row="4" Grid.Column="1" Content="📂 この中間データを開く" Command="{Binding OpenCommand}"
                                    HorizontalAlignment="Left" Padding="10,2" Margin="4,2,0,0"
                                    Visibility="{Binding IsNotCurrent, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <TextBlock Text="{Binding LoadError}" Foreground="#C00000" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <!-- 中身：シートごとの設定 -->
                        <TextBlock Style="{StaticResource SectionHeader}">
                            <Run Text="シート（"/><Run Text="{Binding Sheets.Count, Mode=OneWay}"/><Run Text="）"/>
                        </TextBlock>
                        <TextBlock Text="シートがありません。下の「＋ シートを追加」で追加してください" Style="{StaticResource EmptyHint}"
                                   Visibility="{Binding Sheets.Count, Converter={StaticResource ZeroToVisible}}"/>
                        <ItemsControl ItemsSource="{Binding Sheets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#B8C7D9" BorderThickness="1" CornerRadius="3"
                                            Padding="8,6" Margin="0,0,0,8" Background="#F7FAFD">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Content="削除" Padding="8,1" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.RemoveSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" ToolTip="このシートを中間データから削除します"/>
                                                <Button DockPanel.Dock="Right" Content="タブで開く" Padding="8,1" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.OpenSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.IsCurrent, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Icon, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Name, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SheetBody}" Focusable="False"/>
                                            <WrapPanel Margin="0,2,0,0">
                                                <Button Content="＋ データ元を追加" Style="{StaticResource SmallButton}" Click="AddSource_Click"/>
                                                <Button Content="🔄 更新" Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}"
                                                        ToolTip="このシートを全データ元から読み直して保存します"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource EmptyHint}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- 何も選んでいないとき -->
        <TextBlock Text="左のエクスプローラーで中間データ（.lc）かシートを選択すると、ここで中身を編集できます"
                   TextWrapping="Wrap" Margin="10" Foreground="Gray">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PropertyTarget}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ContentControl Content="{Binding PropertyTarget}" Focusable="False"/>
    </Grid>
</UserControl>
